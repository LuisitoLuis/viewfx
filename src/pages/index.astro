---
import BaseLayout from '../layouts/BaseLayout.astro'
import CodeDialog from '../components/CodeDialog.astro'
import EffectGallery from '../components/EffectGallery.astro'
import HeroSection from '../components/HeroSection.astro'
import UsageSection from '../components/UsageSection.astro'
---

<BaseLayout>
  <HeroSection />
  <EffectGallery />
  <UsageSection />
  <CodeDialog />
</BaseLayout>

<script>
  import { initClipboard } from '../scripts/clipboard'
  import { initCodeDialog } from '../scripts/dialog'
  import { initGallery } from '../scripts/gallery'

  initGallery()
  initCodeDialog()
  initClipboard()
</script>
