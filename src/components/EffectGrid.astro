---
import { EFFECTS } from '../data/effects'
---
<section aria-labelledby="effects-heading" style="margin-bottom: 3rem;">
  <h2 id="effects-heading" class="section-label">Choose an effect</h2>
  <div id="effect-grid" role="list" aria-label="Theme transition effects">
    {EFFECTS.map(e => (
      <article class="ec" data-id={e.id} role="listitem" tabindex="0" aria-label={`${e.name}: ${e.desc}`} aria-pressed="false">
        <div class="ec-active-badge" aria-hidden="true"></div>

        <div class="ec-preview" aria-hidden="true">
          <div class="ec-scene ec-scene-dark">
            <div class="mock-moon"></div>
            <div class="mock-col">
              <div class="mock-rect"></div>
              <div class="mock-rect-sm"></div>
            </div>
          </div>
          <div class={`ec-scene ec-scene-light ${e.previewClass}`}>
            <div class="mock-sun"></div>
            <div class="mock-col">
              <div class="mock-rect" style="background:#7c6fe0"></div>
              <div class="mock-rect-sm" style="background:#cba6f7"></div>
            </div>
          </div>
          <div class="ec-play">
            <div class="ec-play-icon">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="white"><polygon points="5,3 19,12 5,21"/></svg>
            </div>
          </div>
        </div>

        <div class="ec-body">
          <span class="ec-name">{e.name}</span>
          <p class="ec-desc">{e.desc}</p>
        </div>

        <div class="ec-footer">
          <button class="btn-code" data-code={e.id} aria-label={`View ${e.name} CSS code`}>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            Code
          </button>
        </div>
      </article>
    ))}
  </div>
  <div id="effect-status" role="status" aria-live="polite" class="sr-only"></div>
</section>

<script>
  import { EFFECTS } from '../data/effects'
  import { openEffectModal, initModal } from '../scripts/modal'

  let activeEffect = localStorage.getItem('tt-effect') || 'circle'
  const statusEl = document.getElementById('effect-status')

  function activateEffect(id: string) {
    activeEffect = id
    localStorage.setItem('tt-effect', id)
    document.documentElement.setAttribute('data-effect', id)
    updateActiveCard()

    const eff = EFFECTS.find(e => e.id === id)
    if (eff && statusEl) {
      statusEl.textContent = `Active effect: ${eff.name}`
    }
  }

  function updateActiveCard() {
    document.querySelectorAll('.ec').forEach(card => {
      const isActive = (card as HTMLElement).dataset.id === activeEffect
      card.classList.toggle('active', isActive)
      card.setAttribute('aria-pressed', String(isActive))
    })
  }

  function initGrid() {
    const grid = document.getElementById('effect-grid')!

    grid.querySelectorAll('.ec').forEach(card => {
      card.addEventListener('click', e => {
        if ((e.target as HTMLElement).closest('button')) return
        activateEffect((card as HTMLElement).dataset.id!)
      })

      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault()
          activateEffect((card as HTMLElement).dataset.id!)
        }
      })
    })

    grid.querySelectorAll('.btn-code').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation()
        openEffectModal((btn as HTMLElement).dataset.code!, EFFECTS)
      })
    })

    activateEffect(activeEffect)
  }

  initGrid()
  initModal()
</script>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem; letter-spacing: 0.12em;
    text-transform: uppercase; opacity: 0.35; font-weight: 500;
    margin-bottom: 1.5rem;
  }

  #effect-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .ec {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 1rem;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s, transform 0.18s, box-shadow 0.18s;
    text-align: left;
    display: flex; flex-direction: column;
    position: relative;
  }
  .ec:hover {
    border-color: var(--mid);
    transform: translateY(-3px);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--mid) 18%, transparent);
  }
  .ec:focus-visible {
    outline: 2px solid var(--mid);
    outline-offset: 2px;
  }
  .ec.active {
    border-color: var(--mid);
    box-shadow: 0 0 0 1px var(--mid), 0 8px 32px color-mix(in srgb, var(--mid) 22%, transparent);
  }

  .ec-preview {
    height: 110px;
    position: relative;
    overflow: hidden;
    background: var(--code-bg);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ec-scene {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    gap: 0.5rem;
    transition: opacity 0.25s;
  }
  .ec-scene-dark  { background: #1e1a2e; }
  .ec-scene-light { background: #f4f2ff; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }

  .mock-circle  { width: 28px; height: 28px; border-radius: 50%; background: #7c6fe0; opacity: 0.9; }
  .mock-rect    { width: 48px; height: 8px; border-radius: 4px; background: #cba6f7; opacity: 0.7; }
  .mock-rect-sm { width: 32px; height: 6px; border-radius: 3px; background: #7c6fe0; opacity: 0.4; }
  .mock-col     { display: flex; flex-direction: column; gap: 5px; }
  .mock-sun     { width: 20px; height: 20px; border-radius: 50%; background: #f9c74f; box-shadow: 0 0 12px #f9c74f88; }
  .mock-moon    { width: 18px; height: 18px; border-radius: 50%; background: #cba6f7; box-shadow: 0 0 10px #cba6f766; }

  .ec-play {
    position: absolute;
    inset: 0; display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--mid) 0%, transparent);
    transition: background 0.2s;
    opacity: 0;
    pointer-events: none;
  }
  .ec:hover .ec-play { opacity: 1; background: color-mix(in srgb, var(--mid) 10%, transparent); }
  .ec:focus-visible .ec-play { opacity: 1; background: color-mix(in srgb, var(--mid) 10%, transparent); }
  .ec-play-icon {
    width: 32px; height: 32px; border-radius: 50%;
    background: var(--mid);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--mid) 50%, transparent);
  }

  .ec.playing .ec-preview::after {
    content: '';
    position: absolute; inset: 0;
    border: 2px solid var(--mid);
    border-radius: inherit;
    animation: ring-pulse 0.8s ease-out forwards;
    pointer-events: none;
  }
  @keyframes ring-pulse {
    0%   { opacity: 1; }
    100% { opacity: 0; }
  }

  .ec-active-badge {
    position: absolute; top: 0.6rem; right: 0.6rem;
    display: none;
    width: 8px; height: 8px; border-radius: 50%; background: var(--mid);
    box-shadow: 0 0 6px var(--mid);
  }
  .ec.active .ec-active-badge { display: block; }

  .ec-body {
    padding: 1rem 1.1rem 1rem;
    display: flex; flex-direction: column; gap: 0.35rem;
    flex: 1;
  }
  .ec-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem; font-weight: 500; color: var(--mid);
  }
  .ec-desc { font-size: 0.74rem; opacity: 0.55; line-height: 1.55; }

  .ec-footer {
    padding: 0 1.1rem 0.9rem;
    display: flex; align-items: center;
  }
  .btn-code {
    flex: 1;
    height: 1.9rem; border-radius: 0.45rem;
    border: 1px solid var(--border);
    background: transparent; color: var(--soft);
    font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; font-weight: 500;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 0.3rem;
    transition: border-color 0.18s, background 0.18s;
  }
  .btn-code:hover { border-color: var(--soft); background: var(--code-bg); color: var(--fg); }
  .btn-code:focus-visible { border-color: var(--soft); outline: 2px solid var(--soft); outline-offset: 2px; }

  /* ── Preview animations on the mini-scene ────────────── */
  @keyframes mini-wipe-h {
    0%   { clip-path: inset(0 100% 0 0); opacity: 1; }
    60%  { clip-path: inset(0 0% 0 0);   opacity: 1; }
    85%  { clip-path: inset(0 0% 0 0);   opacity: 1; }
    100% { clip-path: inset(0 100% 0 0); opacity: 1; }
  }
  @keyframes mini-wipe-v {
    0%   { clip-path: inset(100% 0 0 0); opacity: 1; }
    60%  { clip-path: inset(0% 0 0 0);   opacity: 1; }
    85%  { clip-path: inset(0% 0 0 0);   opacity: 1; }
    100% { clip-path: inset(100% 0 0 0); opacity: 1; }
  }
  @keyframes mini-fade {
    0%,100% { opacity: 0; } 30%,80% { opacity: 1; }
  }
  @keyframes mini-zoom {
    0%   { opacity: 0; transform: scale(0.8); }
    40%  { opacity: 1; transform: scale(1);   }
    80%  { opacity: 1; transform: scale(1);   }
    100% { opacity: 0; transform: scale(1.1); }
  }
  @keyframes mini-slide {
    0%   { transform: translateX(100%); opacity: 1; }
    50%  { transform: translateX(0);    opacity: 1; }
    85%  { transform: translateX(0);    opacity: 1; }
    100% { transform: translateX(-30%); opacity: 0; }
  }
  @keyframes mini-rotate {
    0%   { opacity: 0; transform: rotate(-8deg) scale(0.88); }
    40%  { opacity: 1; transform: rotate(0) scale(1); }
    80%  { opacity: 1; transform: rotate(0) scale(1); }
    100% { opacity: 0; transform: rotate(8deg) scale(0.88); }
  }
  @keyframes mini-circle-mask {
    0%   { mask-size: 0;        -webkit-mask-size: 0;        opacity: 1; }
    60%  { mask-size: 400px;    -webkit-mask-size: 400px;    opacity: 1; }
    85%  { mask-size: 400px;    -webkit-mask-size: 400px;    opacity: 1; }
    100% { mask-size: 0;        -webkit-mask-size: 0;        opacity: 1; }
  }
  @keyframes mini-polygon {
    0%   { clip-path: polygon(171% 50%, 50% 171%, 50% 171%, 171% 50%); opacity: 1; }
    60%  { clip-path: polygon(171% 50%, 50% 171%, -50% 71%, 50% -71%); opacity: 1; }
    85%  { clip-path: polygon(171% 50%, 50% 171%, -50% 71%, 50% -71%); opacity: 1; }
    100% { clip-path: polygon(171% 50%, 50% 171%, 50% 171%, 171% 50%); opacity: 1; }
  }
  @keyframes mini-diamond-mask {
    0%   { mask-size: 0;     -webkit-mask-size: 0;     opacity: 1; }
    60%  { mask-size: 400px; -webkit-mask-size: 400px; opacity: 1; }
    85%  { mask-size: 400px; -webkit-mask-size: 400px; opacity: 1; }
    100% { mask-size: 0;     -webkit-mask-size: 0;     opacity: 1; }
  }

  .ec:hover .mini-anim-circle,
  .ec:focus-visible .mini-anim-circle {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="white"/></svg>') center / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="20" cy="20" r="20" fill="white"/></svg>') center / 0 no-repeat;
    animation: mini-circle-mask 1.8s ease-in-out infinite;
  }
  .ec:hover .mini-anim-circle-blur,
  .ec:focus-visible .mini-anim-circle-blur {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><defs><filter id="b"><feGaussianBlur stdDeviation="2"/></filter></defs><circle cx="20" cy="20" r="18" fill="white" filter="url(%23b)"/></svg>') center / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><defs><filter id="b"><feGaussianBlur stdDeviation="2"/></filter></defs><circle cx="20" cy="20" r="18" fill="white" filter="url(%23b)"/></svg>') center / 0 no-repeat;
    animation: mini-circle-mask 1.8s ease-in-out infinite;
  }
  .ec:hover .mini-anim-corner-tl,
  .ec:focus-visible .mini-anim-corner-tl {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="0" cy="0" r="18" fill="white"/></svg>') top left / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="0" cy="0" r="18" fill="white"/></svg>') top left / 0 no-repeat;
    mask-origin: content-box; -webkit-mask-origin: content-box;
    animation: mini-circle-mask 1.8s ease-in-out infinite;
  }
  .ec:hover .mini-anim-corner-tr,
  .ec:focus-visible .mini-anim-corner-tr {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="40" cy="0" r="18" fill="white"/></svg>') top right / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><circle cx="40" cy="0" r="18" fill="white"/></svg>') top right / 0 no-repeat;
    mask-origin: content-box; -webkit-mask-origin: content-box;
    animation: mini-circle-mask 1.8s ease-in-out infinite;
  }
  .ec:hover .mini-anim-polygon,
  .ec:focus-visible .mini-anim-polygon   { animation: mini-polygon 1.8s ease-in-out infinite; }
  .ec:hover .mini-anim-diamond,
  .ec:focus-visible .mini-anim-diamond {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><polygon points="20,0 40,20 20,40 0,20" fill="white"/></svg>') center / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40"><polygon points="20,0 40,20 20,40 0,20" fill="white"/></svg>') center / 0 no-repeat;
    animation: mini-diamond-mask 1.8s ease-in-out infinite;
  }
  .ec:hover .mini-anim-hexagon,
  .ec:focus-visible .mini-anim-hexagon {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><polygon points="50,0 93,25 93,75 50,100 7,75 7,25" fill="white"/></svg>') center / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><polygon points="50,0 93,25 93,75 50,100 7,75 7,25" fill="white"/></svg>') center / 0 no-repeat;
    animation: mini-diamond-mask 1.8s ease-in-out infinite;
  }
  .ec:hover .mini-anim-iris,
  .ec:focus-visible .mini-anim-iris {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><polygon points="50,0 61,35 95,35 68,57 79,91 50,70 21,91 32,57 5,35 39,35" fill="white"/></svg>') center / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><polygon points="50,0 61,35 95,35 68,57 79,91 50,70 21,91 32,57 5,35 39,35" fill="white"/></svg>') center / 0 no-repeat;
    animation: mini-diamond-mask 1.8s ease-in-out infinite;
  }
  .ec:hover .mini-anim-ink,
  .ec:focus-visible .mini-anim-ink {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><filter id="t"><feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="12"/></filter></defs><circle cx="50" cy="50" r="50" fill="white" filter="url(%23t)"/></svg>') center / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><filter id="t"><feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="12"/></filter></defs><circle cx="50" cy="50" r="50" fill="white" filter="url(%23t)"/></svg>') center / 0 no-repeat;
    animation: mini-diamond-mask 2s ease-in-out infinite;
  }
  .ec:hover .mini-anim-wipe-h,
  .ec:focus-visible .mini-anim-wipe-h    { animation: mini-wipe-h  1.8s ease-in-out infinite; }
  .ec:hover .mini-anim-wipe-v,
  .ec:focus-visible .mini-anim-wipe-v    { animation: mini-wipe-v  1.8s ease-in-out infinite; }
  .ec:hover .mini-anim-slide,
  .ec:focus-visible .mini-anim-slide     { animation: mini-slide   1.8s ease-in-out infinite; }
  .ec:hover .mini-anim-zoom,
  .ec:focus-visible .mini-anim-zoom      { animation: mini-zoom    1.8s ease-in-out infinite; }
  .ec:hover .mini-anim-rotate,
  .ec:focus-visible .mini-anim-rotate    { animation: mini-rotate  1.8s ease-in-out infinite; }
  .ec:hover .mini-anim-fade,
  .ec:focus-visible .mini-anim-fade      { animation: mini-fade    1.8s ease-in-out infinite; }
  @keyframes mini-slide-down {
    0%   { clip-path: inset(0 0 100% 0); opacity: 1; }
    60%  { clip-path: inset(0 0 0% 0);   opacity: 1; }
    85%  { clip-path: inset(0 0 0% 0);   opacity: 1; }
    100% { clip-path: inset(0 0 100% 0); opacity: 1; }
  }

  .ec:hover .mini-anim-slide-down,
  .ec:focus-visible .mini-anim-slide-down { animation: mini-slide-down 1.8s ease-in-out infinite; }
  .ec:hover .mini-anim-venetian,
  .ec:focus-visible .mini-anim-venetian  { animation: mini-wipe-v  1.8s ease-in-out infinite; }
  .ec:hover .mini-anim-spiral,
  .ec:focus-visible .mini-anim-spiral    { animation: mini-rotate  2s ease-in-out infinite; }
  .ec:hover .mini-anim-heart,
  .ec:focus-visible .mini-anim-heart {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="M50 88 C25 65 5 50 5 30 5 15 15 5 30 5 40 5 48 12 50 18 52 12 60 5 70 5 85 5 95 15 95 30 95 50 75 65 50 88Z" fill="white"/></svg>') center / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="M50 88 C25 65 5 50 5 30 5 15 15 5 30 5 40 5 48 12 50 18 52 12 60 5 70 5 85 5 95 15 95 30 95 50 75 65 50 88Z" fill="white"/></svg>') center / 0 no-repeat;
    animation: mini-diamond-mask 1.8s ease-in-out infinite;
  }
  .ec:hover .mini-anim-glitch,
  .ec:focus-visible .mini-anim-glitch    { animation: mini-wipe-h  0.8s ease-in-out infinite; }
  .ec:hover .mini-anim-mosaic,
  .ec:focus-visible .mini-anim-mosaic {
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect x="0" y="0" width="25" height="25" fill="white"/><rect x="50" y="0" width="25" height="25" fill="white"/><rect x="25" y="25" width="25" height="25" fill="white"/><rect x="75" y="25" width="25" height="25" fill="white"/><rect x="0" y="50" width="25" height="25" fill="white"/><rect x="50" y="50" width="25" height="25" fill="white"/><rect x="25" y="75" width="25" height="25" fill="white"/><rect x="75" y="75" width="25" height="25" fill="white"/></svg>') center / 0 no-repeat;
    -webkit-mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect x="0" y="0" width="25" height="25" fill="white"/><rect x="50" y="0" width="25" height="25" fill="white"/><rect x="25" y="25" width="25" height="25" fill="white"/><rect x="75" y="25" width="25" height="25" fill="white"/><rect x="0" y="50" width="25" height="25" fill="white"/><rect x="50" y="50" width="25" height="25" fill="white"/><rect x="25" y="75" width="25" height="25" fill="white"/><rect x="75" y="75" width="25" height="25" fill="white"/></svg>') center / 0 no-repeat;
    animation: mini-diamond-mask 1.8s ease-in-out infinite;
  }
</style>
