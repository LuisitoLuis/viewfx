---
import BrandMark from './BrandMark.astro'
import Icon from './Icon.astro'
import ThemeToggle from './ThemeToggle.astro'
import { SITE } from '../consts'
import { EFFECTS } from '../data/effects'
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-md">
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 rounded-md" aria-label={`${SITE.name}, home`}>
      <BrandMark class="text-accent-text" />
      <span class="font-mono text-sm font-semibold tracking-tight">{SITE.name}</span>
      <span
        class="label ml-1 hidden rounded-full border border-line px-2.5 py-1.5 text-ink-2 md:inline-flex"
      >
        {EFFECTS.length} effects
      </span>
    </a>

    <nav aria-label="Primary" class="flex items-center gap-1">
      <a href="#gallery" class="btn btn--sm btn--ghost hidden sm:inline-flex">Catalogue</a>
      <a href="#usage" class="btn btn--sm btn--ghost hidden sm:inline-flex">Usage</a>
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--icon btn--ghost"
        aria-label="Source on GitHub, opens in a new tab"
      >
        <Icon name="github" size={17} />
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
