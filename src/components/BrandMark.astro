---
interface Props {
  size?: number
  class?: string
}

const { size = 20, class: className } = Astro.props
---

<!-- public/logo.svg — same mark as public/favicon.svg. Masked so the header
     still inherits currentColor from the page theme. -->
<span
  class:list={['inline-block', className]}
  style={`width:${size}px;height:${size}px;background-color:currentColor;mask:url(/logo.svg) center / contain no-repeat;-webkit-mask:url(/logo.svg) center / contain no-repeat`}
  aria-hidden="true"
></span>
