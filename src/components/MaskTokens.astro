---
import { maskCustomProperties } from '../data/masks'

/**
 * Emits the shared mask shapes as `--mask-*` custom properties.
 *
 * Inline and unprocessed on purpose: these are base64 data URIs that only
 * need to reach `:root`, and keeping them out of the bundled stylesheet avoids
 * the CSS minifier tripping over the SVG payload.
 */
---

<style is:inline set:html={maskCustomProperties()}></style>
