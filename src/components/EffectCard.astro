---
import CodeBlock from './CodeBlock.astro'
import Icon from './Icon.astro'
import type { Effect } from '../data/effects'

interface Props {
  effect: Effect
  index: number
}

const { effect, index } = Astro.props

const descriptionId = `fx-${effect.id}-desc`
const duration = `${(effect.durationMs / 1000).toFixed(1)}s`

/** Everything the toolbar filter matches against, lowercased once at build time. */
const haystack = [effect.name, effect.id, effect.technique, effect.desc]
  .join(' ')
  .toLowerCase()
---

<li
  class="fx-card rise"
  data-fx={effect.id}
  data-name={effect.name}
  data-technique={effect.technique}
  data-search={haystack}
  style={`--i:${index}`}
>
  <button type="button" class="fx-select" aria-describedby={descriptionId}>
    <span class="fx-preview">
      <span class="fx-scene fx-scene--dark">
        <span class="fx-orb"></span>
        <span class="fx-bars"><i></i><i></i></span>
      </span>
      <span class="fx-scene fx-scene--light">
        <span class="fx-orb"></span>
        <span class="fx-bars"><i></i><i></i></span>
      </span>
      <span class="fx-play"><span><Icon name="play" size={12} /></span></span>
    </span>

    <span class="fx-heading">
      <span class="fx-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
      <span class="fx-name">{effect.name}</span>
    </span>
  </button>

  <p id={descriptionId} class="fx-desc">{effect.desc}</p>

  <div class="fx-meta">
    <span class="label">{effect.technique}</span>
    <span class="label" aria-hidden="true">/</span>
    <span class="label tabular-nums">{duration}</span>
    <span class="label fx-flag">Active</span>

    <button type="button" class="btn btn--sm btn--ghost ml-auto" data-open-code>
      <Icon name="code" size={13} />
      CSS
    </button>
  </div>

  <!-- Cloned into the code dialog on demand, so 21 code blocks stay out of the layout. -->
  <template data-code>
    <CodeBlock code={effect.css} filename={`${effect.id}.css`} frame={false} />
  </template>
</li>
