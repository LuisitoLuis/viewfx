---
import CodeBlock from './CodeBlock.astro'
import Icon from './Icon.astro'
import { EFFECTS } from '../data/effects'

const SNIPPET = `const switchTheme = () =>
  document.documentElement.classList.toggle('dark')

document.startViewTransition
  ? document.startViewTransition(switchTheme)
  : switchTheme()`

const STATS = [
  { label: 'Effects', value: String(EFFECTS.length) },
  { label: 'Dependencies', value: '0' },
  { label: 'API calls', value: '1' }
]
---

<section class="border-b border-line">
  <div
    class="shell grid gap-14 py-16 sm:py-20 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-end lg:gap-20 lg:py-28"
  >
    <div>
      <p class="label flex items-center gap-2.5 text-ink-3">
        <span class="inline-block size-1.5 rounded-full bg-accent"></span>
        Specimen catalogue
      </p>

      <h1
        class="mt-7 text-[clamp(2.5rem,7.5vw,4.75rem)] leading-[0.95] font-semibold tracking-[-0.04em] text-balance"
      >
        Twenty-one ways to <em class="font-normal text-accent-text italic"
          >turn out the lights</em
        >.
      </h1>

      <p class="mt-7 max-w-xl text-base leading-relaxed text-pretty text-ink-2 sm:text-lg">
        Dark/light theme transitions built entirely from CSS on top of the native View
        Transitions API. Hover a card to preview it, click to apply it, copy the CSS when
        you find the one.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#gallery" class="btn btn--primary">
          Browse the catalogue
          <Icon name="arrow-down" size={14} />
        </a>
        <button type="button" class="btn btn--outline" data-play-transition>
          <Icon name="play" size={12} />
          Replay the current effect
        </button>
      </div>
    </div>

    <div class="rounded-2xl border border-line bg-surface/60 p-5 backdrop-blur-sm sm:p-6">
      <dl class="grid grid-cols-3 divide-x divide-line">
        {
          STATS.map((stat) => (
            <div class="px-4 first:pl-0 last:pr-0">
              <dt class="label text-ink-3">{stat.label}</dt>
              <dd class="mt-2 font-mono text-2xl tabular-nums sm:text-3xl">{stat.value}</dd>
            </div>
          ))
        }
      </dl>

      <CodeBlock code={SNIPPET} language="js" filename="theme-toggle.js" class="mt-6" />
    </div>
  </div>
</section>
