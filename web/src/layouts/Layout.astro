---
import '@fontsource-variable/geist-mono/index.css'

import '../styles/global.css'

import { SITE } from '../data/site'
import { DEFAULT_EFFECT_CLASS } from '../data/effects'
import { THEME_KEY } from '../lib/theme'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url)
const markdownPath =
  Astro.url.pathname.replace(/\/$/, '') === '' || Astro.url.pathname === '/'
    ? '/index.md'
    : `${Astro.url.pathname.replace(/\/$/, '')}.md`

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.author.url
  }
}

/**
 * Resolves the theme before first paint so it does not flash. Inline and
 * therefore unbundled, which is why the storage key is interpolated from the
 * module that owns it rather than repeated as a literal.
 */
const bootstrap = `(() => {
  const el = document.documentElement
  try {
    const theme = localStorage.getItem('${THEME_KEY}')
    const mode = theme === 'light' || theme === 'dark' || theme === 'auto' ? theme : 'auto'
    const dark = mode === 'dark' || (mode === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches)
    el.classList.toggle('dark', dark)
    el.dataset.themeMode = mode
  } catch {}
})()`
---

<!doctype html>
<html
  lang={SITE.locale}
  data-theme-mode="auto"
  class={`${DEFAULT_EFFECT_CLASS} scrollbar-thin scrollbar-thumb-accent scrollbar-track-paper`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={new URL(markdownPath, SITE.url)} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f6f1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline set:html={bootstrap} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>

  <body id="top" class="min-h-dvh font-display antialiased">
    <a
      class="sr-only font-semibold focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-3 focus:text-accent-ink focus:no-underline focus:outline-2 focus:outline-offset-2 focus:outline-white"
      href="#main">Skip to main content</a>

    <slot />

    <div id="live-region" class="sr-only" role="status" aria-live="polite"></div>
    <div
      id="site-toasts"
      class="pointer-events-none fixed inset-x-0 top-2 z-[100] flex flex-col items-center gap-3 px-4 sm:top-2.5"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <script>
      import { initTheme } from '../lib/theme'
      import { initSectionNav } from '../lib/section-nav'
      initTheme()
      initSectionNav()
    </script>
  </body>
</html>

<style is:global>
  .site-toast {
    pointer-events: auto;
    display: flex;
    max-width: 24rem;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--surface) 95%, transparent);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 1rem 2.5rem -1rem color-mix(in oklab, var(--ink) 28%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-toast__mark {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 18%, transparent);
    color: var(--accent-text);
  }

  .site-toast-enter {
    animation-name: site-toast-in;
    animation-duration: 0.45s;
    animation-timing-function: ease-out;
    animation-fill-mode: both;
  }

  .site-toast-exit {
    animation-name: site-toast-out;
    animation-duration: 0.4s;
    animation-timing-function: ease-in;
    animation-fill-mode: forwards;
  }

  @keyframes site-toast-in {
    from {
      opacity: 0;
      filter: blur(5px);
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @keyframes site-toast-out {
    from {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
    to {
      opacity: 0;
      filter: blur(5px);
      transform: translateY(-0.65rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-toast-enter,
    .site-toast-exit {
      animation-duration: 0.2s;
    }
  }
</style>
