---
import '@fontsource-variable/geist-mono/index.css'

import '../styles/global.css'

import Header from '../sections/Header.astro'
import Footer from '../sections/Footer.astro'
import { SITE } from '../consts'
import { DEFAULT_EFFECT_CLASS } from '../data/effects'
import { THEME_KEY } from '../scripts/theme'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url)

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.author.url
  }
}

/**
 * Resolves the theme before first paint so it does not flash. Inline and
 * therefore unbundled, which is why the storage key is interpolated from the
 * module that owns it rather than repeated as a literal.
 */
const bootstrap = `(() => {
  const el = document.documentElement
  try {
    const theme = localStorage.getItem('${THEME_KEY}')
    const mode = theme === 'light' || theme === 'dark' || theme === 'auto' ? theme : 'auto'
    const dark = mode === 'dark' || (mode === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches)
    el.classList.toggle('dark', dark)
    el.dataset.themeMode = mode
  } catch {}
})()`
---

<!doctype html>
<html
  lang={SITE.locale}
  data-theme-mode="auto"
  class={`${DEFAULT_EFFECT_CLASS} scrollbar-thin scrollbar-thumb-accent scrollbar-track-paper`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f6f1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline set:html={bootstrap} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>

  <body id="top" class="min-h-dvh font-display antialiased">
    <a class="skip-link" href="#main">Skip to main content</a>

    <Header />

    <!-- tabindex makes the skip link land focus here, not just the scroll position. -->
    <main id="main" class="pt-20 sm:pt-24" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <div id="live-region" class="sr-only" role="status" aria-live="polite"></div>
    <div
      id="site-toasts"
      class="pointer-events-none fixed inset-x-0 top-2 z-[100] flex flex-col items-center gap-3 px-4 sm:top-2.5"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <script>
      import { initTheme } from '../scripts/theme'
      initTheme()
    </script>
  </body>
</html>
