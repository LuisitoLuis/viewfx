---
/**
 * Decorative theme snapshot. Hidden from AT — the card button names the effect.
 * Glyphs are drawn for a 16px chip, not the site-wide 24px stroke icons.
 */
const TONES = ['dark', 'light'] as const
---

<span class="fx-preview" aria-hidden="true">
  {
    TONES.map((tone) => (
      <span class:list={['fx-scene', `fx-scene--${tone}`]}>
        <span class="fx-chrome">
          <span class="fx-chrome__dots">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="fx-chrome__bar"></span>
        </span>
        <span class="fx-mock">
          <span class="fx-mock__head">
            <span class="fx-theme">
              {
                tone === 'dark' ? (
                  <svg viewBox="0 0 16 16" width="14" height="14">
                    <path
                      fill="currentColor"
                      d="M11.2 2.1A6.4 6.4 0 1 0 13.9 12 4.9 4.9 0 0 1 11.2 2.1Z"
                    />
                  </svg>
                ) : (
                  <svg viewBox="0 0 16 16" width="14" height="14">
                    <circle cx="8" cy="8" r="3.05" fill="currentColor" />
                    <g
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.35"
                      stroke-linecap="round"
                    >
                      <path d="M8 1.4v1.7M8 12.9v1.7M1.4 8h1.7M12.9 8h1.7M3.05 3.05l1.2 1.2M11.75 11.75l1.2 1.2M3.05 12.95l1.2-1.2M11.75 4.25l1.2-1.2" />
                    </g>
                  </svg>
                )
              }
            </span>
            <span class="fx-bars">
              <span></span>
              <span></span>
            </span>
          </span>
          <span class="fx-mock__hero"></span>
          <span class="fx-mock__row">
            <span class="fx-mock__tile"></span>
            <span class="fx-mock__tile"></span>
          </span>
        </span>
      </span>
    ))
  }
</span>
