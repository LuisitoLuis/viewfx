---
import Icon from './Icon.astro'
import { highlight } from '../lib/highlight'

interface Props {
  code: string
  language?: string
  /** Shown in the header strip; also the filename a visitor would paste into. */
  filename?: string
  copyable?: boolean
  /** Off when the block already sits inside a bordered container. */
  frame?: boolean
  class?: string
}

const {
  code,
  language = 'css',
  filename,
  copyable = true,
  frame = true,
  class: className
} = Astro.props
---

<figure
  data-copy-scope
  class:list={[
    'overflow-hidden bg-inset',
    frame && 'rounded-xl border border-line',
    className
  ]}
>
  {
    (filename || copyable) && (
      <figcaption class="flex items-center justify-between gap-3 border-b border-line px-3 py-2">
        <span class="label truncate text-ink-3">{filename ?? language}</span>

        {copyable && (
          <button type="button" class="btn btn--sm btn--ghost -mr-1" data-copy="pre">
            <Icon name="copy" size={13} />
            <span data-copy-label>Copy</span>
          </button>
        )}
      </figcaption>
    )
  }

  <div class="overflow-auto px-4 py-3.5">
    <pre class="code"><code set:html={highlight(code, language)} /></pre>
  </div>
</figure>
