---
import EffectPreview from './EffectPreview.astro'
import Icon from './Icon.astro'

interface Props {
  effect: {
    id: string
    className: string
    name: string
    desc: string
    technique: string
    durationMs: number
    css: string
  }
  index: number
}

const { effect, index } = Astro.props
const copyId = `fx-copy-${effect.id}`
---

<li
  data-copy-scope
  class="fx-card rise"
  data-fx={effect.id}
  data-class={effect.className}
  data-name={effect.id}
  data-technique={effect.technique}
  style={`--i:${index}`}
>
  <button
    type="button"
    class="fx-select"
    aria-label={`Select ${effect.id}. Preview plays on hover or focus. Click to copy the class.`}
  >
    <EffectPreview />
  </button>

  <div class="fx-meta">
    <span class="fx-name">{effect.id}</span>
    <code id={copyId} hidden>{effect.className}</code>
    <button
      type="button"
      class="fx-copy"
      data-copy={`#${copyId}`}
      data-toast={`Copied "${effect.id}"`}
      aria-label={`Copy class ${effect.className}`}
    >
      <span class="fx-copy__idle" aria-hidden="true">
        <Icon name="copy" size={13} />
      </span>
      <span class="fx-copy__done" aria-hidden="true">
        <Icon name="check" size={13} />
      </span>
      <span class="sr-only" data-copy-label>Copy</span>
    </button>
  </div>
</li>
