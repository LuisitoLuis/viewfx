---
interface Props {
  effect: {
    id: string
    className: string
    name: string
    desc: string
    technique: string
    durationMs: number
    css: string
  }
  index: number
}

const { effect, index } = Astro.props
---

<li
  class="fx-card rise"
  data-fx={effect.id}
  data-class={effect.className}
  data-name={effect.id}
  data-technique={effect.technique}
  style={`--i:${index}`}
>
  <button
    type="button"
    class="fx-select"
    aria-label={`Copy class ${effect.className}. Hover or focus to preview.`}
  >
    <span class="fx-preview">
      <span class="fx-scene fx-scene--dark">
        <span class="fx-orb"></span>
        <span class="fx-bars"><i></i><i></i></span>
      </span>
      <span class="fx-scene fx-scene--light">
        <span class="fx-orb"></span>
        <span class="fx-bars"><i></i><i></i></span>
      </span>
    </span>
    <span class="fx-name">{effect.id}</span>
  </button>
</li>
