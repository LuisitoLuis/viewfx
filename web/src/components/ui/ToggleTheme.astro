---
import SunIcon from '../icons/sun.astro'
import MoonIcon from '../icons/moon.astro'
import MonitorIcon from '../icons/monitor.astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!-- The accessible name is kept in sync with the current theme by lib/theme.js. -->
<button
  id="theme-toggle"
  type="button"
  class:list={['cursor-pointer', className]}
  aria-label="Switch the theme"
>
  <SunIcon class="hidden in-data-[theme-mode=light]:block" />
  <MoonIcon class="hidden in-data-[theme-mode=dark]:block" />
  <MonitorIcon class="hidden in-data-[theme-mode=auto]:block" />
</button>
