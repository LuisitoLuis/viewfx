---
import Icon from './Icon.astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!-- The accessible name is kept in sync with the current theme by scripts/theme.js. -->
<button
  id="theme-toggle"
  type="button"
  class:list={['cursor-pointer', className]}
  aria-label="Switch the theme"
>
  <Icon name="sun" class="hidden in-data-[theme-mode=light]:block" />
  <Icon name="moon" class="hidden in-data-[theme-mode=dark]:block" />
  <Icon name="monitor" class="hidden in-data-[theme-mode=auto]:block" />
</button>
