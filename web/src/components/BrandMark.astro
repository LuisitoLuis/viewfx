---
interface Props {
  class?: string
  iconClass?: string
}

const { class: className, iconClass } = Astro.props
---

<div
  class:list={[
    'flex items-center justify-center rounded-xl bg-accent shadow-lg shadow-accent/20 transition-all duration-300',
    className
  ]}
>
  <svg
    class:list={['text-accent-ink drop-shadow-[0_1px_2px_color-mix(in_oklab,var(--accent-ink)_45%,transparent)]', iconClass]}
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
    <path d="M12 2.75a9.25 9.25 0 0 1 0 18.5Z" fill="currentColor"></path>
  </svg>
</div>

<style is:global>
  @keyframes float-subtle {
    0%,
    100% {
      transform: translateY(0) scale(1);
      opacity: 0.95;
    }
    50% {
      transform: translateY(-2px) scale(1.02);
      opacity: 1;
    }
  }

  .animate-float-subtle {
    animation: float-subtle 4s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-float-subtle {
      animation: none;
    }
  }
</style>
