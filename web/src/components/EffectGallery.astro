---
import EffectCard from './EffectCard.astro'
import Icon from './Icon.astro'
import { EFFECTS, TECHNIQUES } from '../data/effects'
import {
  ANIMATION_DELAY,
  ANIMATION_DURATION,
  ANIMATION_STEPS,
  DEFAULT_DURATION_KEY
} from '../data/timing'
---

<section id="palette" class="fx-gallery" aria-labelledby="palette-heading">
  <div class="shell py-16 sm:py-20">
    <h2 id="palette-heading" class="text-3xl font-semibold tracking-tight sm:text-4xl">
      Effect palette
    </h2>
    <p class="mt-4 max-w-lg leading-relaxed text-ink-2">
      {EFFECTS.length} utilities. Hover to preview, click to copy and play on the page.
    </p>

    <div class="mt-10 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <search class="relative w-full lg:max-w-xs">
        <label for="effect-search" class="sr-only">Search effects</label>
        <Icon
          name="search"
          class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-ink-3"
        />
        <input
          id="effect-search"
          class="field"
          type="search"
          placeholder="Search effects…"
          autocomplete="off"
        />
      </search>

      <div class="flex flex-wrap items-center gap-2">
        <div role="group" aria-label="Filter by technique" class="flex flex-wrap items-center gap-2">
          <button type="button" class="chip label" data-filter="all" aria-pressed="true">All</button>
          {
            TECHNIQUES.map((technique) => (
              <button type="button" class="chip label" data-filter={technique} aria-pressed="false">
                {technique}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="sticky top-20 z-30 mt-8">
      <fieldset class="timing-bar" aria-label="Animation preview options">
        <legend class="sr-only">Customize animation duration, delay, and steps for previews</legend>

        <label class="timing-item">
          <span class="label text-ink-3">
            <span class="sm:hidden">Dur</span>
            <span class="hidden sm:inline">Duration</span>
          </span>
          <select id="preview-duration" class="timing-select" name="duration">
            {
              Object.entries(ANIMATION_DURATION).map(([key, value]) => (
                <option value={value} selected={key === DEFAULT_DURATION_KEY}>
                  {key}
                </option>
              ))
            }
          </select>
        </label>

        <span class="timing-rule hidden sm:block" aria-hidden="true"></span>

        <label class="timing-item">
          <span class="label text-ink-3">Delay</span>
          <select id="preview-delay" class="timing-select" name="delay">
            {Object.entries(ANIMATION_DELAY).map(([key, value]) => (
              <option value={value}>{key}</option>
            ))}
          </select>
        </label>

        <span class="timing-rule hidden sm:block" aria-hidden="true"></span>

        <label class="timing-item">
          <span class="label text-ink-3">Steps</span>
          <select id="preview-steps" class="timing-select" name="steps">
            {Object.entries(ANIMATION_STEPS).map(([key, value]) => (
              <option value={value}>{key}</option>
            ))}
          </select>
        </label>

        <span class="timing-rule" aria-hidden="true"></span>

        <label class="timing-item" for="play-all">
          <span class="switch">
            <input
              id="play-all"
              class="peer sr-only"
              type="checkbox"
              aria-describedby="play-all-help"
            />
            <span class="switch-track" aria-hidden="true"></span>
            <span class="switch-thumb" aria-hidden="true"></span>
          </span>
          <span class="text-sm font-medium text-ink-2">Play all</span>
        </label>
        <p id="play-all-help" class="sr-only">
          When enabled, every animation preview plays in a continuous loop. When disabled, previews
          play on hover or keyboard focus.
        </p>
      </fieldset>
    </div>

    <ul
      id="effect-grid"
      role="list"
      class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
    >
      {EFFECTS.map((effect, index) => <EffectCard effect={effect} index={index + 1} />)}
    </ul>

    <p
      id="effect-empty"
      hidden
      class="mt-8 rounded-xl border border-dashed border-line px-6 py-12 text-center text-ink-2"
    >
      Nothing matches that search.
      <button type="button" id="effect-reset" class="link">Clear the filters</button>
    </p>
  </div>
</section>
