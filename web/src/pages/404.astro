---
import Layout from '@layouts/Layout.astro'
import Header from '@components/layout/Header.astro'
import Footer from '@components/layout/Footer.astro'
import ArrowDownIcon from '@components/icons/arrow-down.astro'
import { SITE } from '../data/site'
---

<Layout title={`Page not found — ${SITE.name}`} description="That page does not exist." noindex>
  <Header />
  <main id="main" class="pt-20 sm:pt-24" tabindex="-1">
    <div class="mx-auto flex min-h-[60vh] w-full max-w-6xl flex-col justify-center px-4 py-20 sm:px-6 lg:px-8">
      <p class="font-mono text-[0.6875rem] leading-none tracking-[0.14em] text-ink-3 uppercase">Error 404</p>
      <h1 class="mt-5 text-[clamp(2.25rem,6vw,4rem)] leading-none font-semibold tracking-[-0.04em]">
        Nothing to transition to.
      </h1>
      <p class="mt-6 max-w-md leading-relaxed text-ink-2">
        This page does not exist. The catalogue of {SITE.name} effects is still where you left it.
      </p>

      <p class="mt-9">
        <a
          href="/"
          class="inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-[0.625rem] bg-accent px-[1.125rem] font-mono text-xs font-medium tracking-[0.06em] text-accent-ink uppercase transition-colors hover:bg-[color-mix(in_oklab,var(--accent)_88%,var(--ink))]"
        >
          <ArrowDownIcon size={14} class="-rotate-90" />
          Back to the catalogue
        </a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>
