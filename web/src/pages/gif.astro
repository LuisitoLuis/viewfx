---
import Layout from '@layouts/Layout.astro'
import Header from '@components/layout/Header.astro'
import Footer from '@components/layout/Footer.astro'
import PlayIcon from '@components/icons/play.astro'
import CopyIcon from '@components/icons/copy.astro'
import { SITE } from '../data/site'
import { ANIMATION_DURATION, DEFAULT_DURATION_KEY } from '../data/timing'

const durations = Object.keys(ANIMATION_DURATION)
const sizes = ['30%', '50%', '70%', '100%', 'cover']

const params = Astro.url.searchParams
const pick = (key: string, allowed: string[], fallback: string) => {
  const value = params.get(key)
  return value && allowed.includes(value) ? value : fallback
}

const initial = {
  d: pick('d', durations, DEFAULT_DURATION_KEY),
  size: pick('size', sizes, '50%')
}

const selectClass =
  'w-full min-h-11 rounded-xl border border-line bg-surface px-3 text-sm text-ink focus-visible:border-accent'

const initialDuration = ANIMATION_DURATION[initial.d as keyof typeof ANIMATION_DURATION] ?? '3s'
const initialHold = initial.size === 'cover' || initial.size === '100%' ? '100vmax' : `${initial.size.replace('%', '')}vmax`
const initialSnippet = `::view-transition-group(root) {
  animation-timing-function: var(--expo-in);
}

::view-transition-new(root) {
  mask: url(' ') center / 0 no-repeat;
  animation: scale ${initialDuration};
  animation-fill-mode: both;
}

::view-transition-old(root),
.dark::view-transition-old(root) {
  animation: scale ${initialDuration};
  animation-fill-mode: both;
}

@keyframes scale {
  0% {
    mask-size: 0;
  }
  10% {
    mask-size: ${initialHold};
  }
  90% {
    mask-size: ${initialHold};
  }
  100% {
    mask-size: 2000vmax;
  }
}`
---

<Layout
  title={`GIF studio — ${SITE.name}`}
  description="Drop a light GIF and a dark GIF, then play a ViewFX wipe on the real View Transitions API."
>
  <Header />
  <main id="main" class="pt-20 sm:pt-24" tabindex="-1">
    <div class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 lg:px-8">
      <div class="mb-8 max-w-2xl">
        <p class="mb-2 font-mono text-[0.6875rem] leading-none tracking-[0.14em] text-accent-text uppercase">
          GIF studio
        </p>
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Wipe between two GIFs</h1>
        <p class="mt-3 max-w-xl text-base leading-relaxed text-ink-2">
          Load a light frame and a dark frame. Play wipes between them with the ViewFX class on
          {' '}
          <code class="font-mono text-[0.95em]">&lt;html&gt;</code>
          . Pick the effect in the
          {' '}
          <a class="font-medium text-accent-text underline-offset-2 hover:underline" href="/playground">playground</a>.
        </p>
      </div>

      <div
        id="gif-studio"
        class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,22rem)] lg:items-start xl:grid-cols-[minmax(0,1fr)_minmax(20rem,24rem)]"
      >
        <section
          class="flex min-h-112 flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-sm"
          aria-label="GIF mask preview"
        >
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-4 py-3">
            <p class="text-xs font-semibold tracking-wide text-ink-3 uppercase">Live page</p>
            <button
              type="button"
              id="play-btn"
              class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-ink-2 transition-colors hover:border-accent hover:text-accent-text"
            >
              <PlayIcon size={14} />
              Play
            </button>
          </div>

          <div class="relative flex flex-1 items-center justify-center overflow-hidden p-8 sm:p-12">
            <div
              class="pointer-events-none absolute inset-0 opacity-40"
              style="background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 32px 32px;"
              aria-hidden="true"
            >
            </div>

            <div class="relative z-10 w-full max-w-md overflow-hidden rounded-2xl border border-line bg-paper shadow-xl">
              <div class="flex items-center gap-2 border-b border-line px-4 py-3">
                <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
                <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
                <span class="size-2.5 rounded-full bg-line-strong" aria-hidden="true"></span>
                <span class="ml-2 truncate font-mono text-[11px] text-ink-3">app.example</span>
              </div>
              <div class="grid gap-4 p-5 sm:grid-cols-[7rem_1fr]">
                <div class="hidden rounded-xl bg-inset sm:block" aria-hidden="true"></div>
                <div>
                  <p class="text-sm font-bold text-ink">Theme surface</p>
                  <p class="mt-1 text-xs leading-relaxed text-ink-2">
                    Play toggles <code class="font-mono">.dark</code> on the whole page. The GIF
                    only exists as the mask during the wipe.
                  </p>
                  <div class="mt-4 grid grid-cols-2 gap-2" aria-hidden="true">
                    <div class="h-16 rounded-lg bg-inset"></div>
                    <div class="h-16 rounded-lg bg-inset"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="border-t border-line bg-inset p-4">
            <label class="flex min-h-20 items-center gap-3 rounded-xl border border-line bg-surface px-3 py-3">
              <img id="gif-thumb" class="size-12 shrink-0 rounded-lg object-cover" alt="" hidden />
              <span class="min-w-0 flex-1">
                <span class="mb-1.5 block text-[10px] font-semibold tracking-wider text-ink-3 uppercase">
                  GIF link
                </span>
                <input
                  id="gif-url"
                  class="w-full min-h-10 rounded-lg border border-line bg-paper px-2.5 font-mono text-xs text-ink placeholder:text-ink-3 focus-visible:border-accent"
                  type="url"
                  inputmode="url"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="https://…/effect.gif"
                />
              </span>
            </label>
          </div>

          <div class="border-t border-line px-4 py-3">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <p class="mb-1 text-[10px] font-semibold tracking-wider text-ink-3 uppercase">
                  CSS
                </p>
                <code
                  id="class-snippet"
                  class="block max-h-96 overflow-auto font-mono text-[12px] leading-relaxed whitespace-pre text-ink"
                >
                  {initialSnippet}
                </code>
              </div>
              <div class="flex shrink-0 flex-col gap-2">
                <button
                  type="button"
                  id="copy-classes"
                  class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-xs font-semibold text-paper"
                >
                  <CopyIcon size={13} />
                  <span data-label>Copy</span>
                </button>
                <button
                  type="button"
                  id="copy-url"
                  class="inline-flex min-h-9 items-center justify-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-ink-2"
                >
                  <span data-label>Share URL</span>
                </button>
              </div>
            </div>
            <code
              id="html-snippet"
              class="mt-2 block overflow-x-auto font-mono text-[12px] leading-relaxed whitespace-pre text-ink-2"
            >
              {`if (!document.startViewTransition) switchTheme()
document.startViewTransition(switchTheme);`}
            </code>
          </div>
        </section>

        <aside class="flex flex-col gap-4 lg:sticky lg:top-24">
          <div class="rounded-2xl border border-line bg-surface p-4">
            <div class="grid gap-3">
              <label class="block">
                <span class="mb-1.5 block text-xs font-semibold tracking-wide text-ink-3 uppercase">
                  Duration
                </span>
                <select id="ctrl-duration" class={selectClass}>
                  {durations.map((key) => (
                    <option value={key} selected={key === initial.d}>
                      {key}
                    </option>
                  ))}
                </select>
              </label>
              <label class="block">
                <span class="mb-1.5 block text-xs font-semibold tracking-wide text-ink-3 uppercase">
                  Mask size
                </span>
                <select id="ctrl-size" class={selectClass}>
                  {sizes.map((key) => (
                    <option value={key} selected={key === initial.size}>
                      {key}
                    </option>
                  ))}
                </select>
              </label>
            </div>
          </div>

          <p class="text-xs leading-relaxed text-ink-3">
            One GIF link for both light and dark. Paste a Tenor, Giphy, or any https URL.
            Transparency works best as a mask.
          </p>
        </aside>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { initGifStudio } from '../lib/gif'
  initGifStudio()
</script>
