---
import EffectCard from '../components/EffectCard.astro'
import { EFFECTS } from '../data/effects'
import {
  ANIMATION_DELAY,
  ANIMATION_DURATION,
  ANIMATION_STEPS,
  DEFAULT_DURATION_KEY
} from '../data/timing'
---

<section
  id="palette"
  class="fx-gallery relative z-0 overflow-hidden bg-inset"
  aria-labelledby="palette-heading"
>
  <div
    class="pointer-events-none h-24 bg-linear-to-b from-paper via-paper/80 to-transparent sm:h-32"
    aria-hidden="true"
  >
  </div>
  <div class="shell py-10 text-center sm:py-12">
    <h2
      id="palette-heading"
      class="fade-up text-2xl font-semibold tracking-tight sm:text-4xl [animation-delay:600ms]"
    >
      Effect Collection
    </h2>
    <p class="fade-up mx-auto mt-3 max-w-xl text-base text-balance text-ink-2 sm:text-lg [animation-delay:700ms]">
      {EFFECTS.length} utilities. Hover to preview, click to copy.
    </p>

    <fieldset
      class="timing-bar fade-up mx-auto mt-8 [animation-delay:800ms]"
      aria-label="Animation preview options"
    >
      <legend class="sr-only">Customize animation duration, delay, and steps for previews</legend>

      <label class="timing-item">
        <span class="label text-ink-3">
          <span class="sm:hidden">Dur</span>
          <span class="hidden sm:inline">Duration</span>
        </span>
        <select id="preview-duration" class="timing-select" name="duration">
          {
            Object.entries(ANIMATION_DURATION).map(([key, value]) => (
              <option value={value} selected={key === DEFAULT_DURATION_KEY}>
                {key}
              </option>
            ))
          }
        </select>
      </label>

      <span class="timing-rule hidden sm:block" aria-hidden="true"></span>

      <label class="timing-item">
        <span class="label text-ink-3">Delay</span>
        <select id="preview-delay" class="timing-select" name="delay">
          {Object.entries(ANIMATION_DELAY).map(([key, value]) => (
            <option value={value}>{key}</option>
          ))}
        </select>
      </label>

      <span class="timing-rule hidden sm:block" aria-hidden="true"></span>

      <label class="timing-item">
        <span class="label text-ink-3">Steps</span>
        <select id="preview-steps" class="timing-select" name="steps">
          {Object.entries(ANIMATION_STEPS).map(([key, value]) => (
            <option value={value}>{key}</option>
          ))}
        </select>
      </label>

      <span class="timing-rule" aria-hidden="true"></span>

      <label class="timing-item" for="play-all">
        <span class="switch">
          <input
            id="play-all"
            class="peer sr-only"
            type="checkbox"
            aria-describedby="play-all-help"
          />
          <span class="switch-track" aria-hidden="true"></span>
          <span class="switch-thumb" aria-hidden="true"></span>
        </span>
        <span class="text-sm font-medium text-ink-2">Play all</span>
      </label>
      <p id="play-all-help" class="sr-only">
        When enabled, every animation preview plays in a continuous loop. When disabled, previews
        play on hover or keyboard focus.
      </p>
    </fieldset>

    <ul
      id="effect-grid"
      role="list"
      class="mx-auto mt-10 grid max-w-5xl grid-cols-2 gap-3 sm:mt-14 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-5"
    >
      {EFFECTS.map((effect, index) => <EffectCard effect={effect} index={index} />)}
    </ul>
  </div>
  <div
    class="pointer-events-none h-24 bg-linear-to-b from-transparent via-paper/80 to-paper sm:h-32"
    aria-hidden="true"
  >
  </div>
</section>
